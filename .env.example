# Kindle Environment Configuration Template
# Copy this file to .env and fill in your keys. Never commit real keys.

# AI Inference Keys (Server-side Edge & Cloudflare Nitro)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Optional Client Fallback Prefix
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kindle Events <notifications@kindle-events.app>"
